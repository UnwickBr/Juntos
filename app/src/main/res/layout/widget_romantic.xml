<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_heart"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_heart"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="0 dias"
            android:textColor="#F6E4E8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:id="@+id/widget_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="·"
            android:textColor="#9C818A"
            android:textSize="15sp" />

        <Chronometer
            android:id="@+id/widget_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#E8B4BC"
            android:textSize="14sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/widget_toggle"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="6dp"
        android:padding="6dp"
        android:background="@drawable/widget_toggle_bg"
        android:src="@drawable/ic_toggle"
        android:contentDescription="@null" />

</LinearLayout>
